{
  "name": "@symbiosis-finance/wdk-protocol-swidge-symbiosis",
  "version": "1.0.0-beta.1",
  "description": "WDK swidge protocol module for any-to-any cross-chain swaps and bridging via the Symbiosis protocol.",
  "keywords": [
    "wdk",
    "protocol",
    "swidge",
    "swap",
    "bridge",
    "cross-chain",
    "symbiosis"
  ],
  "homepage": "https://symbiosis.finance",
  "author": "allush <al.lushnikov@yandex.ru>",
  "license": "Apache-2.0",
  "main": "index.js",
  "type": "module",
  "types": "./types",
  "scripts": {
    "build:types": "tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "@tetherto/wdk-wallet": "^1.0.0-beta.10",
    "bare-node-runtime": "^1.1.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "standard": "^17.1.2",
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "standard": {
    "ignore": [
      "bare.js",
      "tests/**/*.js"
    ]
  }
